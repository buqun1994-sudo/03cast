<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/cast_background"
    android:keepScreenOn="true">

    <SurfaceView
        android:id="@+id/mirror_surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:visibility="gone" />

    <SurfaceView
        android:id="@+id/media_surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/cast_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:contentDescription="@string/playing"
        android:scaleType="fitCenter"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/audio_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="@dimen/cast_page_padding"
        android:paddingEnd="@dimen/cast_page_padding"
        android:visibility="gone">

        <ImageView
            android:id="@+id/audio_artwork"
            android:layout_width="@dimen/cast_artwork_size"
            android:layout_height="@dimen/cast_artwork_size"
            android:contentDescription="@string/audio_playing"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_cast" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="48dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/audio_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="@string/unknown_title"
                android:textColor="@color/cast_text_primary"
                android:textSize="@dimen/cast_title_size"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/audio_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/cast_text_secondary"
                android:textSize="@dimen/cast_body_size" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/interaction_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/waiting_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="@dimen/cast_page_padding">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:translationY="@dimen/cast_waiting_primary_translation_y">

            <ImageView
                android:id="@+id/waiting_icon"
                android:layout_width="@dimen/cast_icon_large"
                android:layout_height="@dimen/cast_icon_large"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_cast" />

            <TextView
                android:id="@+id/waiting_device_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/waiting_device_name"
                android:textColor="@color/cast_text_primary"
                android:textSize="@dimen/cast_title_size"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/waiting_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="56dp"
                android:text="@string/waiting_title"
                android:textColor="@color/cast_text_secondary"
                android:textSize="@dimen/cast_status_size" />

            <ProgressBar
                android:id="@+id/start_progress"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginTop="28dp"
                android:indeterminateTint="@color/cast_accent" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/waiting_bottom_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <include
                layout="@layout/view_cast_commercial_waiting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/cast_commercial_waiting_pro_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:gravity="center"
                android:maxWidth="760dp"
                android:minHeight="32dp"
                android:textColor="@color/cast_text_secondary"
                android:textSize="@dimen/cast_caption_size"
                android:visibility="gone" />

            <TextView
                android:id="@+id/settings_button"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/cast_touch_target"
                android:layout_marginBottom="48dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/settings"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minHeight="0dp"
                android:paddingStart="48dp"
                android:paddingEnd="48dp"
                android:text="@string/settings"
                android:textAllCaps="false"
                android:textColor="@color/cast_accent"
                android:textSize="@dimen/cast_body_size" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/waiting_fullscreen_exit_button"
            android:layout_width="@dimen/cast_media_secondary_control_size"
            android:layout_height="@dimen/cast_media_secondary_control_size"
            android:layout_gravity="top|end"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="32dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/exit_fullscreen"
            android:padding="@dimen/cast_media_secondary_icon_padding"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_fullscreen_exit"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/error_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/cast_page_padding"
        android:visibility="gone">

        <TextView
            android:id="@+id/error_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:maxWidth="720dp"
            android:text="@string/receiver_start_failed"
            android:textColor="@color/cast_text_primary"
            android:textSize="@dimen/cast_status_size"
            android:textStyle="bold" />

        <Button
            android:id="@+id/retry_button"
            android:layout_width="260dp"
            android:layout_height="@dimen/cast_touch_target"
            android:layout_marginTop="40dp"
            android:background="@drawable/retry_button_background"
            android:text="@string/retry"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="@dimen/cast_body_size" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/settings_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="@dimen/cast_settings_sidebar_width"
                android:layout_height="match_parent"
                android:background="@drawable/cast_settings_sidebar"
                android:orientation="vertical"
                android:paddingStart="@dimen/cast_settings_sidebar_padding"
                android:paddingTop="@dimen/cast_settings_content_padding_vertical"
                android:paddingEnd="@dimen/cast_settings_sidebar_padding"
                android:paddingBottom="@dimen/cast_settings_content_padding_vertical">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/cast_settings_title_height">

                    <TextView
                        android:id="@+id/settings_title_text"
                        style="@style/SettingsText.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:gravity="center"
                        android:text="@string/app_name" />

                    <TextView
                        android:id="@+id/settings_entitlement_badge"
                        android:layout_width="@dimen/commercial_badge_width"
                        android:layout_height="@dimen/commercial_badge_height"
                        android:layout_alignBottom="@id/settings_title_text"
                        android:layout_marginStart="8dp"
                        android:layout_marginBottom="8dp"
                        android:layout_toEndOf="@id/settings_title_text"
                        android:background="@drawable/bg_commercial_corner_badge"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="@string/commercial_badge_checking"
                        android:textColor="@color/commercial_expired_text"
                        android:textSize="@dimen/commercial_badge_text" />
                </RelativeLayout>

                <LinearLayout
                    android:id="@+id/settings_navigation_receiver"
                    android:layout_width="@dimen/cast_settings_navigation_width"
                    android:layout_height="@dimen/cast_settings_navigation_height"
                    android:layout_marginTop="28dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="27dp"
                    android:paddingEnd="27dp">

                    <ImageView
                        android:id="@+id/settings_navigation_receiver_icon"
                        android:layout_width="@dimen/cast_settings_navigation_icon"
                        android:layout_height="@dimen/cast_settings_navigation_icon"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_cast" />

                    <TextView
                        android:id="@+id/settings_navigation_receiver_label"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="@dimen/cast_settings_navigation_label_spacing"
                        android:layout_weight="1"
                        android:gravity="center_vertical|start"
                        android:text="@string/settings_receiver"
                        android:textColor="@color/cast_text_primary"
                        android:textSize="@dimen/cast_body_size"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/settings_navigation_safety"
                    android:layout_width="@dimen/cast_settings_navigation_width"
                    android:layout_height="@dimen/cast_settings_navigation_height"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="27dp"
                    android:paddingEnd="27dp">

                    <ImageView
                        android:id="@+id/settings_navigation_safety_icon"
                        android:layout_width="@dimen/cast_settings_navigation_icon"
                        android:layout_height="@dimen/cast_settings_navigation_icon"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_safety" />

                    <TextView
                        android:id="@+id/settings_navigation_safety_label"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="@dimen/cast_settings_navigation_label_spacing"
                        android:layout_weight="1"
                        android:gravity="center_vertical|start"
                        android:text="@string/settings_safety"
                        android:textColor="@color/cast_text_primary"
                        android:textSize="@dimen/cast_body_size"
                    android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/settings_navigation_entitlement"
                    android:layout_width="@dimen/cast_settings_navigation_width"
                    android:layout_height="@dimen/cast_settings_navigation_height"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="27dp"
                    android:paddingEnd="27dp">

                    <ImageView
                        android:id="@+id/settings_navigation_entitlement_icon"
                        android:layout_width="@dimen/cast_settings_navigation_icon"
                        android:layout_height="@dimen/cast_settings_navigation_icon"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_settings_navigation_entitlement" />

                    <TextView
                        android:id="@+id/settings_navigation_entitlement_label"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="@dimen/cast_settings_navigation_label_spacing"
                        android:layout_weight="1"
                        android:gravity="center_vertical|start"
                        android:text="@string/settings_navigation_entitlement"
                        android:textColor="@color/cast_text_primary"
                        android:textSize="@dimen/cast_body_size"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <LinearLayout
                    android:id="@+id/settings_navigation_about"
                    android:layout_width="@dimen/cast_settings_navigation_width"
                    android:layout_height="@dimen/cast_settings_navigation_height"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="27dp"
                    android:paddingEnd="27dp">

                    <ImageView
                        android:id="@+id/settings_navigation_about_icon"
                        android:layout_width="@dimen/cast_settings_navigation_icon"
                        android:layout_height="@dimen/cast_settings_navigation_icon"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_settings_navigation_about" />

                    <TextView
                        android:id="@+id/settings_navigation_about_label"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="@dimen/cast_settings_navigation_label_spacing"
                        android:layout_weight="1"
                        android:gravity="center_vertical|start"
                        android:text="@string/settings_navigation_about"
                        android:textColor="@color/cast_text_primary"
                        android:textSize="@dimen/cast_body_size"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/cast_settings_content"
                android:orientation="vertical">

                <include layout="@layout/view_cast_commercial_summary" />

                <ScrollView
                    android:id="@+id/settings_content_scroll"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:fillViewport="true"
                    android:overScrollMode="never">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:id="@+id/settings_receiver_content"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingStart="@dimen/cast_settings_content_padding_start"
                            android:paddingTop="@dimen/cast_settings_content_padding_vertical"
                            android:paddingEnd="@dimen/cast_settings_content_padding_end"
                            android:paddingBottom="@dimen/cast_settings_content_padding_vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/settings_receiver_title"
                                android:textColor="@color/cast_text_primary"
                                android:textSize="@dimen/cast_title_size"
                                android:textStyle="bold" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/cast_settings_card_height"
                                android:layout_marginTop="@dimen/cast_settings_group_spacing"
                                android:background="@drawable/cast_settings_card"
                                android:gravity="center_vertical"
                                android:orientation="vertical"
                                android:paddingStart="@dimen/cast_settings_card_padding"
                                android:paddingEnd="@dimen/cast_settings_card_padding">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/settings_device_name"
                                    android:textColor="@color/cast_text_secondary"
                                    android:textSize="@dimen/cast_caption_size" />

                                <TextView
                                    android:id="@+id/settings_device_name_value"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/cast_settings_caption_spacing"
                                    android:text="@string/waiting_device_name"
                                    android:textColor="@color/cast_text_primary"
                                    android:textSize="@dimen/cast_body_size"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/cast_settings_card_height"
                                android:layout_marginTop="@dimen/cast_settings_item_spacing"
                                android:background="@drawable/cast_settings_card"
                                android:gravity="center_vertical"
                                android:orientation="vertical"
                                android:paddingStart="@dimen/cast_settings_card_padding"
                                android:paddingEnd="@dimen/cast_settings_card_padding">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/settings_receiver_availability"
                                    android:textColor="@color/cast_text_primary"
                                    android:textSize="@dimen/cast_body_size"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/cast_settings_caption_spacing"
                                    android:text="@string/settings_receiver_availability_summary"
                                    android:textColor="@color/cast_text_secondary"
                                    android:textSize="@dimen/cast_caption_size" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/cast_settings_caption_spacing"
                                    android:text="@string/settings_receiver_stop_summary"
                                    android:textColor="@color/cast_text_secondary"
                                    android:textSize="@dimen/cast_caption_size" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/cast_settings_card_height"
                                android:layout_marginTop="@dimen/cast_settings_item_spacing"
                                android:background="@drawable/cast_settings_card"
                                android:gravity="center_vertical"
                                android:orientation="vertical"
                                android:paddingStart="@dimen/cast_settings_card_padding"
                                android:paddingEnd="@dimen/cast_settings_card_padding">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/settings_receiver_protocol"
                                    android:textColor="@color/cast_text_primary"
                                    android:textSize="@dimen/cast_body_size"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/cast_settings_caption_spacing"
                                    android:text="@string/settings_receiver_protocol_summary"
                                    android:textColor="@color/cast_text_secondary"
                                    android:textSize="@dimen/cast_caption_size" />
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/settings_safety_content"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingStart="@dimen/cast_settings_content_padding_start"
                            android:paddingTop="@dimen/cast_settings_content_padding_vertical"
                            android:paddingEnd="@dimen/cast_settings_content_padding_end"
                            android:paddingBottom="@dimen/cast_settings_content_padding_vertical"
                            android:visibility="gone">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/settings_safety_title"
                                android:textColor="@color/cast_text_primary"
                                android:textSize="@dimen/cast_title_size"
                                android:textStyle="bold" />

                            <LinearLayout
                                android:id="@+id/driving_guard_setting"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/cast_settings_card_height"
                                android:layout_marginTop="@dimen/cast_settings_group_spacing"
                                android:background="@drawable/cast_settings_card"
                                android:clickable="true"
                                android:focusable="true"
                                android:gravity="center_vertical"
                                android:importantForAccessibility="no"
                                android:orientation="horizontal"
                                android:paddingStart="@dimen/cast_settings_card_padding"
                                android:paddingEnd="@dimen/cast_settings_card_padding">

                                <com.tcrrry.desktopcast.IcarSwitch
                                    android:id="@+id/driving_guard_switch"
                                    android:layout_width="@dimen/cast_settings_switch_width"
                                    android:layout_height="@dimen/cast_settings_switch_height"
                                    android:contentDescription="@string/settings_driving_guard" />

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/cast_settings_text_spacing"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/settings_driving_guard"
                                        android:textColor="@color/cast_text_primary"
                                        android:textSize="@dimen/cast_body_size"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:id="@+id/driving_guard_summary"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="@dimen/cast_settings_caption_spacing"
                                        android:text="@string/settings_driving_guard_summary"
                                        android:textColor="@color/cast_text_secondary"
                                        android:textSize="@dimen/cast_caption_size" />
                                </LinearLayout>
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/cast_settings_card_height"
                                android:layout_marginTop="@dimen/cast_settings_item_spacing"
                                android:background="@drawable/cast_settings_card"
                                android:gravity="center_vertical"
                                android:orientation="vertical"
                                android:paddingStart="@dimen/cast_settings_card_padding"
                                android:paddingEnd="@dimen/cast_settings_card_padding">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/settings_driving_state"
                                    android:textColor="@color/cast_text_secondary"
                                    android:textSize="@dimen/cast_caption_size" />

                                <TextView
                                    android:id="@+id/driving_state_value"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/cast_settings_caption_spacing"
                                    android:text="@string/settings_driving_state_unavailable"
                                    android:textColor="@color/cast_text_primary"
                                    android:textSize="@dimen/cast_body_size"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </LinearLayout>

                        <include layout="@layout/content_settings_commercial" />
                        <include layout="@layout/content_settings_about" />
                    </FrameLayout>
                </ScrollView>
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/driving_guard_warning"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/cast_dialog_scrim"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="@dimen/cast_settings_dialog_width"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="@drawable/cast_settings_dialog"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="@dimen/cast_settings_dialog_padding">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:contentDescription="@string/driving_guard_warning_title"
                    android:src="@drawable/ic_safety"
                    android:tint="@color/cast_danger" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center"
                    android:text="@string/driving_guard_warning_title"
                    android:textColor="@color/cast_danger"
                    android:textSize="@dimen/cast_title_size"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center"
                    android:text="@string/driving_guard_warning_message"
                    android:textColor="@color/cast_text_primary"
                    android:textSize="@dimen/cast_caption_size" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:text="@string/driving_guard_warning_detail"
                    android:textColor="@color/cast_text_secondary"
                    android:textSize="@dimen/cast_caption_size" />

                <ImageView
                    android:id="@+id/driving_guard_agreement_qr"
                    android:layout_width="176dp"
                    android:layout_height="176dp"
                    android:layout_marginTop="16dp"
                    android:background="@android:color/white"
                    android:contentDescription="@string/driving_guard_agreement_qr_content_description"
                    android:padding="8dp"
                    android:scaleType="centerInside" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:text="@string/driving_guard_agreement_qr_hint"
                    android:textColor="@color/cast_text_secondary"
                    android:textSize="@dimen/cast_caption_size" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/driving_guard_keep_button"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/cast_settings_dialog_button_height"
                        android:layout_marginEnd="@dimen/cast_settings_dialog_button_gap"
                        android:layout_weight="1"
                        android:background="@drawable/cast_settings_primary_button"
                        android:text="@string/driving_guard_keep"
                        android:textAllCaps="false"
                        android:textColor="@android:color/white"
                        android:textSize="@dimen/cast_body_size" />

                    <Button
                        android:id="@+id/driving_guard_disable_button"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/cast_settings_dialog_button_height"
                        android:layout_weight="1"
                        android:background="@drawable/cast_settings_danger_button"
                        android:text="@string/driving_guard_disable"
                        android:textAllCaps="false"
                        android:textColor="@android:color/white"
                        android:textSize="@dimen/cast_body_size" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/safety_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/cast_safety_background"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="@dimen/cast_settings_dialog_width"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/cast_settings_dialog"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="@dimen/cast_settings_dialog_padding">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:contentDescription="@string/driving_safety_title"
                android:src="@drawable/ic_safety"
                android:tint="@color/cast_danger" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:text="@string/driving_safety_title"
                android:textColor="@color/cast_danger"
                android:textSize="@dimen/cast_title_size"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/safety_countdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:textColor="@color/cast_text_primary"
                android:textSize="@dimen/cast_body_size" />
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/top_controls"
        android:layout_width="match_parent"
        android:layout_height="@dimen/cast_top_bar_height"
        android:background="@android:color/transparent"
        android:clipChildren="false"
        android:paddingStart="@dimen/cast_page_padding"
        android:paddingEnd="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:layout_marginEnd="120dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/protocol_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/cast_control_foreground"
                android:textSize="@dimen/cast_body_size"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/media_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="28dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#BFFFFFFF"
                android:textSize="@dimen/cast_caption_size" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/close_button"
            android:layout_width="@dimen/cast_media_secondary_control_size"
            android:layout_height="@dimen/cast_media_secondary_control_size"
            android:layout_gravity="top|end"
            android:layout_marginTop="24dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/end_cast"
            android:padding="@dimen/cast_media_secondary_icon_padding"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_close" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/media_controls"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:visibility="gone">

        <androidx.media3.ui.PlayerControlView
            android:id="@+id/media_control_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            app:animation_enabled="false"
            app:controller_layout_id="@layout/cast_media_control_view"
            app:show_fastforward_button="false"
            app:show_next_button="false"
            app:show_previous_button="false"
            app:show_rewind_button="false"
            app:show_shuffle_button="false"
            app:show_subtitle_button="false"
            app:show_timeout="0"
            app:show_vr_button="false" />
    </FrameLayout>

</FrameLayout>
