<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:id="@+id/cast_bottom_control_group"
        android:layout_width="match_parent"
        android:layout_height="@dimen/cast_media_secondary_control_size"
        android:layout_gravity="bottom"
        android:layout_marginBottom="@dimen/cast_media_control_bottom_margin"
        android:background="@android:color/transparent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/cast_page_padding"
        android:paddingEnd="@dimen/cast_page_padding">

        <FrameLayout
            android:id="@+id/cast_play_control_group"
            android:layout_width="@dimen/cast_media_secondary_control_size"
            android:layout_height="@dimen/cast_media_secondary_control_size"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="@dimen/cast_control_gap">

            <ImageButton
                android:id="@id/exo_play_pause"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/play"
                android:padding="@dimen/cast_media_secondary_icon_padding"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_play" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/cast_next_control_group"
            android:layout_width="@dimen/cast_media_secondary_control_size"
            android:layout_height="@dimen/cast_media_secondary_control_size"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="@dimen/cast_control_gap"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/cast_next"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/next_video"
                android:padding="@dimen/cast_media_secondary_icon_padding"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_skip_next" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/cast_timeline_group"
            android:layout_width="0dp"
            android:layout_height="@dimen/cast_media_timeline_height"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/cast_position"
                android:layout_width="@dimen/cast_media_time_width"
                android:layout_height="match_parent"
                android:gravity="center_vertical|end"
                android:includeFontPadding="false"
                android:text="0:00"
                android:textColor="@color/cast_control_foreground"
                android:textSize="@dimen/cast_media_time_text_size" />

            <androidx.media3.ui.DefaultTimeBar
                android:id="@id/exo_progress"
                android:layout_width="0dp"
                android:layout_height="@dimen/cast_media_timeline_height"
                android:layout_marginStart="@dimen/cast_control_gap"
                android:layout_marginEnd="@dimen/cast_control_gap"
                android:layout_weight="1"
                app:bar_height="@dimen/cast_media_progress_bar_height"
                app:buffered_color="@color/cast_control_buffered"
                app:played_color="@color/cast_accent"
                app:scrubber_color="@color/cast_accent"
                app:scrubber_dragged_size="@dimen/cast_media_progress_thumb_dragged"
                app:scrubber_enabled_size="@dimen/cast_media_progress_thumb"
                app:touch_target_height="@dimen/cast_media_timeline_height"
                app:unplayed_color="@color/cast_control_unplayed" />

            <TextView
                android:id="@id/exo_duration"
                android:layout_width="@dimen/cast_media_time_width"
                android:layout_height="match_parent"
                android:gravity="center_vertical|start"
                android:includeFontPadding="false"
                android:text="0:00"
                android:textColor="@color/cast_control_foreground"
                android:textSize="@dimen/cast_media_time_text_size" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/cast_fullscreen_control_group"
            android:layout_width="@dimen/cast_media_secondary_control_size"
            android:layout_height="@dimen/cast_media_secondary_control_size"
            android:layout_marginStart="@dimen/cast_control_gap">

            <ImageButton
                android:id="@id/exo_fullscreen"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/enter_fullscreen"
                android:padding="@dimen/cast_media_secondary_icon_padding"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_fullscreen" />
        </FrameLayout>
    </LinearLayout>
</merge>
